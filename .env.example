# ==============================================================================
# @file       .env.example
# @brief      Environment variables template for Gestell Mini-ECU dev environment
# @company    Gestell Company
#
# USAGE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in the real token values (get them from your team lead)
#   3. NEVER commit .env to git — it is in .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Docker build-time secret (required when running: docker compose build)
# ------------------------------------------------------------------------------
BUILD_TOKEN=REPLACE_WITH_YOUR_BUILD_TOKEN

# ------------------------------------------------------------------------------
# Docker runtime access token (required when running any docker compose service)
# ------------------------------------------------------------------------------
GESTELL_TOKEN=REPLACE_WITH_YOUR_RUNTIME_TOKEN
